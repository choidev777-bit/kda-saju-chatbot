{
  "$schema": "https://tokens.studio/schemas/tokens.json",
  "version": 1,
  "color": {
    "background": "#F6F7F4",
    "surface": "#FFFFFF",
    "surfaceMuted": "#EEF1EC",
    "text": "#232623",
    "textMuted": "#68706A",
    "primary": "#246A73",
    "primaryHover": "#1D565D",
    "accent": "#B85C38",
    "accentMuted": "#F6E5DC",
    "info": "#315EA8",
    "infoMuted": "#E7EEFB",
    "border": "#D6DDD4",
    "success": "#357A4F",
    "warning": "#9B6818",
    "danger": "#B54141"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "xxl": "32px"
  },
  "radius": {
    "sm": "2px",
    "md": "4px",
    "lg": "8px"
  },
  "typography": {
    "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "bodySize": "16px",
    "smallSize": "14px",
    "captionSize": "12px",
    "lineHeight": "1.5",
    "headingWeight": "700",
    "bodyWeight": "400"
  },
  "semantic": {
    "page": {
      "background": "{color.background}",
      "text": "{color.text}"
    },
    "surface": {
      "default": "{color.surface}",
      "muted": "{color.surfaceMuted}",
      "border": "{color.border}"
    },
    "text": {
      "default": "{color.text}",
      "muted": "{color.textMuted}",
      "inverse": "#FFFFFF"
    },
    "action": {
      "default": "{color.primary}",
      "hover": "{color.primaryHover}",
      "accent": "{color.accent}"
    },
    "status": {
      "info": "{color.info}",
      "infoBackground": "{color.infoMuted}",
      "success": "{color.success}",
      "warning": "{color.warning}",
      "danger": "{color.danger}"
    }
  },
  "component": {
    "page": {
      "background": "{semantic.page.background}",
      "maxWidth": "760px"
    },
    "sidebar": {
      "background": "{semantic.surface.muted}",
      "border": "{semantic.surface.border}"
    },
    "chat": {
      "assistantBubble": "{semantic.surface.default}",
      "userBubble": "{color.infoMuted}",
      "border": "{semantic.surface.border}",
      "radius": "{radius.lg}"
    },
    "quickAction": {
      "background": "{semantic.surface.default}",
      "text": "{semantic.action.default}",
      "border": "{semantic.surface.border}",
      "radius": "{radius.md}"
    },
    "profileSummary": {
      "background": "{semantic.surface.default}",
      "readyText": "{semantic.status.success}",
      "pendingText": "{semantic.status.warning}",
      "radius": "{radius.md}"
    },
    "debugPanel": {
      "background": "{semantic.surface.muted}",
      "text": "{semantic.text.muted}",
      "radius": "{radius.md}"
    }
  }
}
